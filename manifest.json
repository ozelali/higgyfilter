{
  "manifest_version": 3,
  "name": "HiggsFieldFilter",
  "version": "1.2.1",
  "description": "Hide Higgsfield mentions and promotions on YouTube, X, Reddit, Instagram, and Threads.",
  "content_scripts": [{
    "matches": [
      "https://www.youtube.com/*",
      "https://x.com/*",
      "https://twitter.com/*",
      "https://www.reddit.com/*",
      "https://www.instagram.com/*",
      "https://www.threads.com/*",
      "https://www.threads.net/*"
    ],
    "js": ["matching.js", "content.js"],
    "css": ["filter.css"],
    "run_at": "document_start"
  }]
}
